# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 云侧模型：当前只用 DeepSeek，必填
DEEPSEEK_API_KEY=
# 可选：阿里云百炼（qwen-turbo/plus/max），未接入时留空即可
DASHSCOPE_API_KEY=

# 本地 vLLM（OpenAI 兼容端点）
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

# RAG 场景的 embedding 模型（CPU 推理，默认值已指向本机 bge）
AS_EMBEDDING_MODEL=D:/fishmatrix-llm/models/bge-base-zh-v1.5

# 运行时路径（相对项目根目录）
AS_DB_PATH=runtime/state.db
AS_TRACE_DIR=runtime/traces
AS_ARTIFACTS_DIR=runtime/artifacts
AS_WORKSPACE_DIR=runtime/workspace

# 可选：全局单会话成本上限（元）；--max-cost 与 profile.budget 优先
# AS_MAX_COST_CNY=1

# ---- Web API（asagent web）----
# 公网部署必须替换为随机 64 字节：python -c "import secrets;print(secrets.token_urlsafe(48))"
AS_JWT_SECRET=dev-only-change-me
AS_ACCESS_TTL_MINUTES=30
AS_REFRESH_TTL_DAYS=30
AS_COOKIE_NAME=as_refresh
# 生产环境必须为 true（HTTPS）。本地 http://127.0.0.1 调试时改为 false
AS_COOKIE_SECURE=true
# 逗号分隔的允许来源；为空则不校验 Origin（仅适合本地开发）
AS_ALLOWED_ORIGINS=https://example.com
# 桌面端（Tauri）支持：允许 tauri://localhost 等来源，并可返回 body 刷新令牌
AS_DESKTOP_CLIENTS=true
# 配额默认值（可被管理端按用户覆盖）
AS_DEFAULT_DAILY_COST_LIMIT=5
AS_DEFAULT_SESSION_COST_LIMIT=0.5
AS_DEFAULT_CONCURRENT_SESSIONS=1
AS_GLOBAL_MAX_PARALLEL=4
# code 场景仅管理员可用
AS_CODE_ADMIN_ONLY=true

# ---- 移动端版本检查（GET /api/app/version，公开）----
# latest 留空时取后端 __version__；min_supported 留空时等同 latest（不强制更新）
# AS_APP_LATEST_VERSION=0.2.0
# AS_APP_MIN_VERSION=0.1.0
# AS_APP_ANDROID_URL=https://github.com/wrui8/asagent/releases/latest
# AS_APP_RELEASE_NOTES=修复若干问题

# ---- 中间件（v2 分阶段演进；默认全部关闭，保持 v1 单机行为）----
# 开关默认值即 v1：sqlite / legacy / 单 worker。
# 容器部署时主机名用 compose 服务名（postgres/redis/rabbitmq/milvus/tei）；
# 宿主直跑 `uv run asagent web` 时改为 127.0.0.1（shell 环境变量优先于本文件）。
# 注意 TEI 只有宿主机端口不同：容器内 http://tei:80，宿主为 http://127.0.0.1:8081。
# 连接串含密码，只写本文件或 deploy/.env，不要提交。
# AS_STORAGE_BACKEND=sqlite            # sqlite | postgres（阶段 2）
# AS_PG_DSN=postgresql://asagent:<set-me>@postgres:5432/asagent
# AS_REDIS_URL=redis://redis:6379/0
# AS_RABBITMQ_URL=amqp://asagent:<set-me>@rabbitmq:5672/
# AS_RAG_BACKEND=sqlite                # sqlite | milvus（阶段 1）
# AS_MILVUS_URI=http://milvus:19530
# AS_TEI_URL=http://tei:80
# AS_EMBEDDING_DIM=1024
# AS_ENGINE=legacy                     # legacy（v1 手写循环）| langgraph（阶段 3）
# AS_CHECKPOINTER=sqlite               # langgraph 下 redis 会把每步摘要镜像到 asagent:ckpt:*（不影响恢复）
# AS_MEMORY_ENABLED=false              # 记忆子系统（阶段 4）；需 postgres + redis + rabbitmq + milvus/tei
# AS_MEMORY_TOP_K=5                    # 每次注入的长期记忆条数
# AS_MEMORY_DAILY_EXTRACT_LIMIT=20     # 每用户每日异步抽取配额
# AS_MEMORY_MODEL=deepseek-chat        # 抽取使用的模型（需强模型生成结构化 JSON）
# AS_WORKERS=1                         # >1 需要 AS_STORAGE_BACKEND=postgres 且配置 AS_REDIS_URL
# AS_LOCAL_DB_PATH=runtime/local.db
# 仅本地/CI 的 PG 用例使用（tests/test_storage_pg.py），不是应用配置；
# 未设置时自动跳过。示例：postgresql://asagent:<set-me>@127.0.0.1:5432/asagent_test
# AS_TEST_PG_DSN=

# ---- Docker 部署（deploy/docker-compose.yml）----
# 以下三项是 compose 插值变量，不是应用环境变量：
# 写入 shell 或 deploy/.env（compose 文件同目录）后生效。
# 容器内路径 → 宿主路径映射；code 沙箱需要调用宿主 Docker
# 注意：Windows Docker Desktop 无法把 named pipe 暴露进 Linux 容器，
# 因此容器部署下 code 场景不可用；需宿主直跑或 Linux 部署
# AS_SANDBOX_PATH_MAP=/app/runtime=D:/code/AS/runtime
# 宿主上的 bge 模型目录（挂载到容器 /models）
# BGE_MODEL_DIR=D:/fishmatrix-llm/models
# Linux 宿主的 Docker socket（Windows 默认 //./pipe/docker_engine）
# DOCKER_SOCKET=/var/run/docker.sock
# 构建镜像时使用的软件源（默认国内镜像；海外部署改为官方源）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PYPI_FILES_MIRROR=https://pypi.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

# ---- 中间件插值变量（写入 deploy/.env，不是本文件）----
# docker compose 读取 compose 文件同目录的 deploy/.env 做插值；
# 缺少密码时 `--profile state` / `--profile rag` 启动会直接报错（fail-closed）。
# AS_PG_DB=asagent
# AS_PG_USER=asagent
# AS_PG_PASSWORD=<set-me>
# AS_RABBITMQ_USER=asagent
# AS_RABBITMQ_PASSWORD=<set-me>
# Milvus 使用内置 etcd + 本地磁盘存储（deploy/milvus/），无需 MinIO 凭据
# 含 bge-m3 权重的宿主目录（TEI 以只读方式挂载到 /data）
# BGE_M3_DIR=D:/fishmatrix-llm/models
# AS_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-latest
# AS_TEI_MAX_BATCH_TOKENS=2048
# AS_TEI_MAX_CLIENT_BATCH=16
# AS_MILVUS_IMAGE=milvusdb/milvus:v2.5.4
